# Local-only settings for zero-cache (loaded by `pnpm zero:cache`). Safe to commit: dev creds only.
ZERO_UPSTREAM_DB=postgres://zero:zero@localhost:5434/zero
# zero-cache keeps a SQLite replica of Postgres here.
ZERO_REPLICA_FILE=/tmp/instant-ui-zero-replica.db
# zero-cache calls these app endpoints to resolve queries and run mutations.
ZERO_QUERY_URL=http://localhost:3000/api/zero/query
ZERO_MUTATE_URL=http://localhost:3000/api/zero/mutate
ZERO_PORT=4848
